# =============================================================================
# ForensiQ Environment Configuration Template
# Copy to .env and adjust values for your environment.
# =============================================================================

# --- Application Settings ---
APP_NAME=ForensiQ
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Database Configuration ---
# Default SQLite configuration for local development and testing:
DATABASE_URL=sqlite:///./forensiq.db
# PostgreSQL production configuration example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/forensiq

# --- Ingestion & Storage Settings ---
UPLOAD_STAGING_DIR=data/staging
UPLOAD_SOURCE_DIR=data/sources
MAX_INGESTION_FILE_SIZE_MB=50
INGESTION_BATCH_SIZE=10000
CORRELATION_WINDOW_SECONDS=300

# --- Security & Authentication (Phase 9A / 9C) ---
# WARNING: In production (APP_ENV=production), DEBUG must be false and JWT_SECRET
# must be an explicitly defined high-entropy secret (>=32 characters).
JWT_SECRET=forensiq-dev-insecure-secret-key-change-in-production-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
ENABLE_API_DOCS=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_ANALYSIS_PER_MINUTE=30
