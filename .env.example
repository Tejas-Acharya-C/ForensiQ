# =============================================================================
# ForensiQ Environment Configuration Template
# Copy to .env and adjust values for your environment.
# Authentication has been removed — local single-investigator workstation mode.
# =============================================================================

# --- Application Settings ---
APP_NAME=ForensiQ
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Storage & Database Configuration ---
# By default, ForensiQ stores databases, evidence, staging files, reports,
# and logs in an isolated user-local application directory:
#   Windows:      %LOCALAPPDATA%\ForensiQ\
#   Linux/macOS:  $XDG_DATA_HOME/forensiq or ~/.local/share/forensiq
#
# To customize the root storage directory, set FORENSIQ_APP_DATA_DIR:
# FORENSIQ_APP_DATA_DIR=C:/ForensiQData

# Explicit Database URL override (must be an absolute path or external database):
# SQLite example (absolute path):
# DATABASE_URL=sqlite:///C:/Users/username/AppData/Local/ForensiQ/database/forensiq.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/forensiq

# --- Ingestion Settings ---
MAX_INGESTION_FILE_SIZE_MB=50
INGESTION_BATCH_SIZE=10000
CORRELATION_WINDOW_SECONDS=300

# --- Frontend & Network Binding ---
SERVE_FRONTEND=true
CORS_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]
ENABLE_API_DOCS=true
RATE_LIMIT_ANALYSIS_PER_MINUTE=30
