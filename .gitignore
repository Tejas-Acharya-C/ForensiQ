# =============================================================================
# ForensiQ Git Ignore Policy
# Strictly prevents committing secrets, runtime databases, local evidence,
# and transient build or test artifacts.
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env.bak/
venv.bak/

# Environment settings
.env.local
.env.*.local

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*_test_results.json

# Database files & SQLite sidecars
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
*.log
logs/

# Runtime evidence storage, staging & trial directories
data/staging/
data/sources/
data/dev/
data/trial/
data/test_staging/
data/test_sources/
backend/data/
data/scratch/
scratch/
uploads/

# Generated Test Outputs, PDFs & Temporary Files
*.pdf
*.tmp
